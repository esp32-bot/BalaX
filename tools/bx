#!/usr/bin/env bash
# BalaX dev tool: build, flash and talk to the robot over USB or Wi-Fi (LAN).
#
#   lan-flash [host] [--force]       build & flash over Wi-Fi (defaults to balax.local; checks battery >=30% & temps)
#   balax lan-flash [host] [--force] same as lan-flash (works from any folder after install-cli)
#   balax lan-cmd [host] <cmd>       run a console command over Wi-Fi (defaults to balax.local)
#   balax lan-monitor [host]         stream live logs over Wi-Fi (defaults to balax.local)
#   balax build                      compile firmware (incremental, cached)
#   balax build-stub                 compile standalone minimal factory OTA stub (ota_stub/)
#   balax flash                      build, then flash over USB
#   balax monitor                    USB serial console and logs; Ctrl+] quits
#   balax run                        USB flash, then monitor
#   balax cmd <command>...           run console commands over USB
#   balax test                       run laptop tests (C++ and Python), no robot needed
#   balax install-cli                install `balax` and `lan-flash` into ~/.local/bin
#   balax erase                      wipe the robot's flash, settings included
#   balax dist [stable|dev]          package firmware into web/fw/<channel>/ for OTA
#   balax preview                    render the status screen to host/build/preview.png
#   balax idf <args>...              any idf.py command, with ESP-IDF set up
#
# BX_PORT picks the USB serial port; BX_IP picks the default LAN host (default: balax.local).
# BX_QUIET=1 logs verbose ESP-IDF output to build/bx-build.log (automatic for lan-flash &
# non-interactive shells; set BX_VERBOSE=1 to force full live build output).
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
TOOLS_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
if [[ -f "$PWD/CMakeLists.txt" && -d "$PWD/main" ]]; then
  REPO="$PWD"
elif [[ -f "$TOOLS_DIR/../CMakeLists.txt" ]]; then
  REPO="$(cd "$TOOLS_DIR/.." && pwd)"
else
  REPO="$(cd "$TOOLS_DIR/../../balax" 2>/dev/null && pwd || pwd)"
fi
IDF_VERSION=v6.1.1
PINNED_IDF="$HOME/esp/$IDF_VERSION/esp-idf"
FLASH_BAUD="${BX_BAUD:-1500000}"  # the M5StickC Plus USB chip's fastest reliable rate

usage() {
  sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
}

# Non-interactive callers (e.g. Zed ACP / CI / pipes) freeze or bloat if flooded with
# Ninja/CMake/esptool ANSI progress streams. Auto-enable quiet log-file mode unless BX_VERBOSE=1.
is_quiet() {
  if [[ "${BX_VERBOSE:-0}" == "1" ]]; then
    return 1
  fi
  if [[ "${BX_QUIET:-0}" == "1" ]]; then
    return 0
  fi
  if [[ ! -t 1 || "${TERM:-}" == "dumb" ]]; then
    return 0
  fi
  return 1
}

strip_ansi() {
  sed -E 's/\x1B\[[0-9;?]*[ -/]*[@-~]//g; s/\r//g'
}

setup_idf() {
  if [[ "${IDF_PATH:-}" != "$PINNED_IDF" ]] || ! command -v idf.py >/dev/null; then
    if [[ ! -f "$PINNED_IDF/export.sh" ]]; then
      echo "ESP-IDF $IDF_VERSION not found at $PINNED_IDF" >&2
      exit 1
    fi
    . "$PINNED_IDF/export.sh" >/dev/null 2>&1
  fi
  export IDF_CCACHE_ENABLE=1
}

# sdkconfig is generated from sdkconfig.defaults and sdkconfig.local, but ESP-IDF keeps the
# values already in it. So bx keeps a copy of what it was generated from, and starts it over
# when that changes, a deleted sdkconfig.local included.
SDKCONFIG_SOURCES="$REPO/build/sdkconfig.sources"

sdkconfig_sources() {
  cat "$REPO/sdkconfig.defaults" "$REPO/sdkconfig.local" 2>/dev/null || true
}

idf() {
  if [[ "$(cat "$SDKCONFIG_SOURCES" 2>/dev/null)" != "$(sdkconfig_sources)" ]]; then
    rm -f "$REPO/sdkconfig"
  fi
  local status=0
  if is_quiet && [[ "${1:-}" == "build" || "${1:-}" == "flash" || "${1:-}" == "erase-flash" ]]; then
    local log_file="$REPO/build/bx-${1}.log"
    mkdir -p "$REPO/build"
    idf.py -C "$REPO" "$@" >"$log_file" 2>&1 || status=$?
    if [[ "$status" -eq 0 ]]; then
      if [[ "${1:-}" == "build" ]]; then
        local bin="$REPO/build/balax.bin"
        local size="?"
        if [[ -f "$bin" ]]; then
          size="$(wc -c < "$bin" | tr -d ' ')"
        fi
        echo "✓ Built build/balax.bin (${size} bytes) — log: build/bx-build.log"
      else
        echo "✓ idf.py $* succeeded — log: build/bx-${1}.log"
      fi
    else
      echo "✗ idf.py $* failed (exit $status) — last 40 lines (full log: build/bx-${1}.log):" >&2
      strip_ansi <"$log_file" | tail -n 40 >&2
    fi
  else
    idf.py -C "$REPO" "$@" || status=$?
  fi
  # Only into a CMake build directory: idf.py refuses a build/ that holds anything else.
  if [[ -f "$REPO/build/CMakeCache.txt" ]]; then
    sdkconfig_sources >"$SDKCONFIG_SOURCES"
  fi
  return "$status"
}

# ESP-IDF's Python, which has pyserial, without the second it takes to set up all of ESP-IDF.
idf_python() {
  local release="${IDF_VERSION#v}"
  release="${release%.*}"  # the env is named after major.minor: 6.1
  local found=("$HOME"/.espressif/python_env/idf"$release"_py*_env/bin/python)
  if [[ ! -x "${found[0]}" ]]; then
    echo "ESP-IDF's Python env not found in ~/.espressif/python_env" >&2
    exit 1
  fi
  echo "${found[0]}"
}

robot_port() {
  if [[ -n "${BX_PORT:-}" ]]; then
    echo "$BX_PORT"
    return
  fi
  shopt -s nullglob
  local ports=(/dev/cu.usbserial-* /dev/cu.wchusbserial*)
  case ${#ports[@]} in
    1) echo "${ports[0]}" ;;
    0) echo "No robot on USB. Plug it in and turn it on." >&2; exit 1 ;;
    *) echo "Several serial ports (${ports[*]}); pick one with BX_PORT=..." >&2; exit 1 ;;
  esac
}

install_cli() {
  local bin_dir="$HOME/.local/bin"
  mkdir -p "$bin_dir"
  ln -sf "$TOOLS_DIR/bx" "$bin_dir/balax"
  ln -sf "$TOOLS_DIR/bx" "$bin_dir/bx"
  cat >"$bin_dir/lan-flash" <<EOF
#!/usr/bin/env bash
exec "$TOOLS_DIR/bx" lan-flash "\$@"
EOF
  chmod +x "$bin_dir/lan-flash"
  echo "✓ Installed global commands in $bin_dir:"
  echo "    lan-flash [balax.local]     # build & flash over Wi-Fi from any directory"
  echo "    balax <cmd>                 # run any BalaX tool command from any directory"
}

lan_flash() {
  local target="${BX_IP:-balax.local}"
  local arg
  for arg in "$@"; do
    if [[ "$arg" != -* ]]; then
      target="$arg"
      break
    fi
  done
  echo "[1/2] Building BalaX firmware..."
  setup_idf
  BX_QUIET="${BX_QUIET:-1}" idf build
  echo "[2/2] Flashing over Wi-Fi to ${target}..."
  python3 "$TOOLS_DIR/lan.py" flash "$@"
}

# Firmware code that's plain C++, built for the laptop.
HOST_BUILD="$REPO/host/build"
SHARED_COMP="$REPO/../tools/components"
if [[ ! -d "$SHARED_COMP" ]]; then
  SHARED_COMP="$REPO/components"
fi
HOST_FLAGS=(-std=c++23 -O2 -Wall -Wextra -Werror
  -I"$SHARED_COMP/gfx/include" -I"$SHARED_COMP/m5stickc_plus/include" -I"$REPO/main")

# The firmware's plain C++ logic, tested on the laptop.
HOST_TESTED=("$REPO/main/balance.cpp" "$REPO/main/remote_protocol.cpp" "$REPO/main/telemetry_stream.cpp"
  "$REPO/main/status_view.cpp" "$SHARED_COMP/gfx/canvas.cpp")

host_tests() {
  mkdir -p "$HOST_BUILD"
  c++ "${HOST_FLAGS[@]}" -I"$REPO/host" "$REPO"/host/tests.cpp "$REPO"/host/test_*.cpp "${HOST_TESTED[@]}" \
    -o "$HOST_BUILD/tests"
  "$HOST_BUILD/tests"
}

preview() {
  mkdir -p "$HOST_BUILD"
  c++ "${HOST_FLAGS[@]}" "$REPO/host/preview.cpp" "$REPO/main/status_view.cpp" "$SHARED_COMP/gfx/canvas.cpp" \
    -lz -o "$HOST_BUILD/preview"
  "$HOST_BUILD/preview" "$HOST_BUILD/preview.png"
  echo "$HOST_BUILD/preview.png"
}

# Flash and monitor through the environment, not -p/-b: a -b would also set the monitor's
# baud rate, which has to stay at the console's.
with_robot() {
  ESPPORT="$(robot_port)" ESPBAUD="$FLASH_BAUD" idf "$@"
}

command="${1:-}"
shift || true

build_stub() {
  setup_idf
  mkdir -p "$REPO/ota_stub/build"
  local log_file="$REPO/ota_stub/build/stub-build.log"
  if idf.py -C "$REPO/ota_stub" build >"$log_file" 2>&1; then
    local sz="$(wc -c < "$REPO/ota_stub/build/ota_stub.bin" | tr -d ' ')"
    echo "✓ Built ota_stub/build/ota_stub.bin (${sz} bytes) — log: ota_stub/build/stub-build.log"
  else
    echo "✗ ota_stub build failed (last 40 lines):" >&2
    strip_ansi <"$log_file" | tail -n 40 >&2
    return 1
  fi
}

case "$command" in
  build)       setup_idf; idf build ;;
  build-stub)  build_stub ;;
  flash)       setup_idf; with_robot flash ;;
  monitor)     setup_idf; with_robot monitor ;;
  run)         setup_idf; with_robot flash monitor ;;
  erase)       setup_idf; with_robot erase-flash ;;
  idf)         setup_idf; idf "$@" ;;
  cmd)         "$(idf_python)" "$TOOLS_DIR/console.py" --port "$(robot_port)" "$@" ;;
  lan-flash)   lan_flash "$@" ;;
  lan-monitor) python3 "$TOOLS_DIR/lan.py" monitor "$@" ;;
  lan-cmd)     python3 "$TOOLS_DIR/lan.py" cmd "$@" ;;
  install-cli) install_cli ;;
  gui)         python3 "$TOOLS_DIR/gui.py" "$@" ;;
  dist)        python3 "$TOOLS_DIR/dist.py" --channel "${1:-dev}" ;;
  test)        host_tests; "$(idf_python)" -B -m unittest discover -s "$TOOLS_DIR" "$@" ;;
  preview)     preview ;;
  ""|help|-h|--help) usage ;;
  *)           usage >&2; exit 1 ;;
esac
