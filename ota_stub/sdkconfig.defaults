# Physically minimal ESP32 OTA stub configuration (-Os, 80 MHz, STA-only, IPv4-only, zero logs).
CONFIG_IDF_TARGET="esp32"
CONFIG_ESP32_REV_MIN_1=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions_compact.csv"

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_FREERTOS_HZ=200

# Strip all log strings and unused TCP/IP & Wi-Fi features for minimum binary size
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_ESP_GRATUITOUS_ARP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
