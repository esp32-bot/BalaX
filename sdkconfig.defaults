# The source of truth for the build configuration; sdkconfig is generated from it.
# One robot's own settings go in sdkconfig.local (gitignored), e.g. CONFIG_BALAX_DEFAULT_VOLUME=70.

# M5StickC Plus: ESP32-PICO-D4 rev v1.0, 4 MB flash
CONFIG_IDF_TARGET="esp32"
CONFIG_ESP32_REV_MIN_1=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Coolest & most energy-efficient configuration for the sealed M5StickC Plus enclosure:
# - 80 MHz CPU matches the 80 MHz APB bus required by Wi-Fi & 400 kHz I2C with minimum heat.
# - 200 Hz RTOS tick (5 ms) evenly divides the 100 Hz (10 ms) control loop with 5x fewer idle wakeups.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_FREERTOS_HZ=200

# Enable ESP power management (waiti clock-gating + Wi-Fi modem-sleep coordination)
CONFIG_PM_ENABLE=y
# Time spent in each task, for the CPU load on the status screen & `probe` command
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Quieter, faster boot
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Save a core dump to flash on a crash; read it with `idf.py coredump-info`
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
